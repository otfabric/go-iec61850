-----// FindIED returns the IED with the given name, or nil if not found.
-----func (s *SCL) FindIED(name string) *IED {
-----	for i := range s.IEDs {
-----		if s.IEDs[i].Name == name {
-----			return &s.IEDs[i]
-----		}
-----	}
-----	return nil
-----}
