				mms.NewUnsigned(uint64(i)),
				mms.NewUTCTime(time.Time{}),
				mms.NewBoolean(false),
				mms.NewBitStringWithLength([]byte{0x00}, 2),
			})
			_ = srv.handleControlWrite(ctx, "LD1", "GGIO1", []string{"SPCSO1", "SBOw"}, "SBOw", selectVal)

