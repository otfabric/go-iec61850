-----+	var callbackCount int
-----+	var callbackMu sync.Mutex
-----+
-----+	sub, err := client.SubscribeReport(ctx, "cbRpt", SubscribeReportOptions{
-----+		QueueSize:      1,
-----+		OverflowPolicy: OverflowCallback,
