-------// --- Conversion from XML to model ---
-------
-------func convertSCL(raw *xmlSCL) (*SCL, error) {
-------	s := &SCL{
-------		Header: Header{
-------			ID:       raw.Header.ID,
-------			Version:  raw.Header.Version,
-------			Revision: raw.Header.Revision,
-------		},
-------	}
-------
-------	for _, rawIED := range raw.IEDs {
-------		ied, err := convertIED(rawIED)
-------		if err != nil {
-------			return nil, err
-------		}
-------		s.IEDs = append(s.IEDs, *ied)
-------	}
-------
-------	dtt, err := convertDataTypeTemplates(raw.DataTypeTemplates)
-------	if err != nil {
-------		return nil, err
-------	}
-------	s.DataTypeTemplates = *dtt
-------
-------	return s, nil
-------}
-------
-------func convertIED(raw xmlIED) (*IED, error) {
-------	ied := &IED{
-------		Name:         raw.Name,
-------		Desc:         raw.Desc,
-------		Manufacturer: raw.Manufacturer,
-------		Type:         raw.Type,
-------	}
-------
-------	for _, rawAP := range raw.AccessPoints {
-------		ap := AccessPoint{Name: rawAP.Name}
-------		if rawAP.Server != nil {
-------			srv := &Server{}
-------			for _, rawLD := range rawAP.Server.LDevices {
-------				ld, err := convertLDevice(rawLD)
-------				if err != nil {
-------					return nil, fmt.Errorf("scl: IED %q LD %q: %w", raw.Name, rawLD.Inst, err)
-------				}
-------				srv.LDevices = append(srv.LDevices, *ld)
-------			}
-------			ap.Server = srv
-------		}
-------		ied.AccessPoints = append(ied.AccessPoints, ap)
-------	}
-------
-------	return ied, nil
-------}
-------
-------func convertLDevice(raw xmlLDevice) (*LDevice, error) {
-------	ld := &LDevice{
-------		Inst: raw.Inst,
-------		Desc: raw.Desc,
-------	}
-------
-------	if raw.LN0 != nil {
-------		ln, err := convertLN(*raw.LN0)
-------		if err != nil {
-------			return nil, fmt.Errorf("LN0: %w", err)
-------		}
-------		ld.LN0 = ln
-------	}
-------
-------	for _, rawLN := range raw.LNs {
-------		ln, err := convertLN(rawLN)
-------		if err != nil {
-------			return nil, fmt.Errorf("LN %s%s%s: %w", rawLN.Prefix, rawLN.LNClass, rawLN.Inst, err)
-------		}
-------		ld.LNs = append(ld.LNs, *ln)
-------	}
-------
-------	return ld, nil
-------}
-------
-------func convertLN(raw xmlLN) (*LN, error) {
-------	ln := &LN{
-------		Prefix:  raw.Prefix,
-------		LNClass: raw.LNClass,
-------		Inst:    raw.Inst,
-------		LNType:  raw.LNType,
-------		Desc:    raw.Desc,
-------	}
-------
-------	for _, rawDOI := range raw.DOIs {
-------		ln.DOIs = append(ln.DOIs, convertDOI(rawDOI))
-------	}
-------	for _, rawDS := range raw.DataSets {
-------		ln.DataSets = append(ln.DataSets, convertDataSet(rawDS))
-------	}
-------	for _, rawRC := range raw.Reports {
-------		rc, err := convertReportControl(rawRC)
-------		if err != nil {
-------			return nil, err
-------		}
-------		ln.Reports = append(ln.Reports, *rc)
-------	}
-------	for _, rawLog := range raw.Logs {
-------		ln.Logs = append(ln.Logs, Log(rawLog))
-------	}
-------
-------	return ln, nil
-------}
-------
-------func convertDOI(raw xmlDOI) DOI {
-------	doi := DOI{Name: raw.Name, Desc: raw.Desc}
-------	for _, d := range raw.DAIs {
-------		doi.DAIs = append(doi.DAIs, DAI(d))
-------	}
-------	for _, s := range raw.SDIs {
-------		doi.SDIs = append(doi.SDIs, convertSDI(s))
-------	}
-------	return doi
-------}
-------
-------func convertSDI(raw xmlSDI) SDI {
-------	sdi := SDI{Name: raw.Name}
-------	for _, d := range raw.DAIs {
-------		sdi.DAIs = append(sdi.DAIs, DAI(d))
-------	}
-------	for _, s := range raw.SDIs {
-------		sdi.SDIs = append(sdi.SDIs, convertSDI(s))
-------	}
-------	return sdi
-------}
-------
-------func convertDataSet(raw xmlDataSet) DataSet {
-------	ds := DataSet{Name: raw.Name, Desc: raw.Desc}
-------	for _, f := range raw.FCDAs {
-------		ds.FCDAs = append(ds.FCDAs, FCDA(f))
-------	}
-------	return ds
-------}
-------
-------func convertReportControl(raw xmlReportControl) (*ReportControl, error) {
-------	rc := &ReportControl{
-------		Name:   raw.Name,
-------		Desc:   raw.Desc,
-------		RptID:  raw.RptID,
-------		DatSet: raw.DatSet,
-------	}
-------
-------	if raw.ConfRev != "" {
-------		v, err := strconv.ParseUint(raw.ConfRev, 10, 32)
-------		if err != nil {
-------			return nil, fmt.Errorf("scl: ReportControl %q: invalid confRev %q: %w", raw.Name, raw.ConfRev, err)
-------		}
-------		rc.ConfRev = uint32(v)
-------	}
-------
-------	rc.Buffered = raw.Buffered == "true"
-------
-------	if raw.BufTime != "" {
-------		v, err := strconv.ParseUint(raw.BufTime, 10, 32)
-------		if err != nil {
-------			return nil, fmt.Errorf("scl: ReportControl %q: invalid bufTime %q: %w", raw.Name, raw.BufTime, err)
-------		}
-------		rc.BufTime = uint32(v)
-------	}
-------
-------	if raw.IntgPd != "" {
-------		v, err := strconv.ParseUint(raw.IntgPd, 10, 32)
-------		if err != nil {
-------			return nil, fmt.Errorf("scl: ReportControl %q: invalid intgPd %q: %w", raw.Name, raw.IntgPd, err)
-------		}
-------		rc.IntgPd = uint32(v)
-------	}
-------
-------	if raw.TrgOps != nil {
-------		rc.TrgOps = TrgOps{
-------			Dchg:   raw.TrgOps.Dchg == "true",
-------			Qchg:   raw.TrgOps.Qchg == "true",
-------			Dupd:   raw.TrgOps.Dupd == "true",
-------			Period: raw.TrgOps.Period == "true",
-------			GI:     raw.TrgOps.GI == "true",
-------		}
-------	}
-------
-------	if raw.OptFields != nil {
-------		rc.OptFields = OptFields{
-------			SeqNum:     raw.OptFields.SeqNum == "true",
-------			TimeStamp:  raw.OptFields.TimeStamp == "true",
-------			DataSet:    raw.OptFields.DataSet == "true",
-------			ReasonCode: raw.OptFields.ReasonCode == "true",
-------			DataRef:    raw.OptFields.DataRef == "true",
-------			EntryID:    raw.OptFields.EntryID == "true",
-------			ConfigRef:  raw.OptFields.ConfigRef == "true",
-------			BufOvfl:    raw.OptFields.BufOvfl == "true",
-------		}
-------	}
-------
-------	return rc, nil
-------}
-------
-------func convertDataTypeTemplates(raw xmlDataTypeTemplates) (*DataTypeTemplates, error) {
-------	dtt := &DataTypeTemplates{}
-------
-------	for _, rawLNT := range raw.LNodeTypes {
-------		lnt := LNodeType{
-------			ID:      rawLNT.ID,
-------			LNClass: rawLNT.LNClass,
-------			Desc:    rawLNT.Desc,
-------		}
-------		for _, d := range rawLNT.DOs {
-------			lnt.DOs = append(lnt.DOs, DO(d))
-------		}
-------		dtt.LNodeTypes = append(dtt.LNodeTypes, lnt)
-------	}
-------
-------	for _, rawDOT := range raw.DOTypes {
-------		dot := DOType{
-------			ID:   rawDOT.ID,
-------			CDC:  rawDOT.CDC,
-------			Desc: rawDOT.Desc,
-------		}
-------		for _, d := range rawDOT.DAs {
-------			da := DA{
-------				Name:  d.Name,
-------				FC:    d.FC,
-------				BType: d.BType,
-------				Type:  d.Type,
-------				Desc:  d.Desc,
-------				Val:   d.Val,
-------			}
-------			if d.Count != "" {
-------				v, err := strconv.Atoi(d.Count)
-------				if err != nil {
-------					return nil, fmt.Errorf("scl: DOType %q DA %q: invalid count %q: %w", rawDOT.ID, d.Name, d.Count, err)
-------				}
-------				da.Count = v
-------			}
-------			dot.DAs = append(dot.DAs, da)
-------		}
-------		for _, s := range rawDOT.SDOs {
-------			dot.SDOs = append(dot.SDOs, SDO(s))
-------		}
-------		dtt.DOTypes = append(dtt.DOTypes, dot)
-------	}
-------
-------	for _, rawDAT := range raw.DATypes {
-------		dat := DAType{
-------			ID:   rawDAT.ID,
-------			Desc: rawDAT.Desc,
-------		}
-------		for _, b := range rawDAT.BDAs {
-------			bda := BDA{
-------				Name:  b.Name,
-------				BType: b.BType,
-------				Type:  b.Type,
-------				Desc:  b.Desc,
-------				Val:   b.Val,
-------			}
-------			if b.Count != "" {
-------				v, err := strconv.Atoi(b.Count)
-------				if err != nil {
-------					return nil, fmt.Errorf("scl: DAType %q BDA %q: invalid count %q: %w", rawDAT.ID, b.Name, b.Count, err)
-------				}
-------				bda.Count = v
-------			}
-------			dat.BDAs = append(dat.BDAs, bda)
-------		}
-------		dtt.DATypes = append(dtt.DATypes, dat)
-------	}
-------
-------	for _, rawEnum := range raw.EnumTypes {
-------		et := EnumType{
-------			ID:   rawEnum.ID,
-------			Desc: rawEnum.Desc,
-------		}
-------		for _, v := range rawEnum.Vals {
-------			ord := 0
-------			if v.Ord != "" {
-------				parsed, err := strconv.Atoi(v.Ord)
-------				if err != nil {
-------					return nil, fmt.Errorf("scl: EnumType %q: invalid ord %q: %w", rawEnum.ID, v.Ord, err)
-------				}
-------				ord = parsed
-------			}
-------			et.Vals = append(et.Vals, EnumVal{Ord: ord, Desc: v.Desc})
-------		}
-------		dtt.EnumTypes = append(dtt.EnumTypes, et)
-------	}
-------
-------	return dtt, nil
-------}
