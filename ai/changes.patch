---------// ArrayValue creates a Value from a slice of element Values.
---------func ArrayValue(elements []*Value) *Value {
---------	mmsElements := make([]*mms.Value, len(elements))
---------	for i, e := range elements {
---------		mmsElements[i] = e.MMS()
---------	}
---------	return NewValue(mms.NewArray(mmsElements))
