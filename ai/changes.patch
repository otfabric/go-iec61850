-----// Generate writes an SCL model as XML to the given writer.
-----//
-----// The output is deterministic: elements appear in the order they are
-----// stored in the model slices. Round-trip loss is minimal for the
-----// supported SCL subset (Header, Substation, Communication, IED,
-----// DataTypeTemplates).
-----func Generate(w io.Writer, s *SCL) error {
-----	if _, err := io.WriteString(w, xml.Header); err != nil {
-----		return fmt.Errorf("scl: generate: %w", err)
-----	}
-----
-----	raw := modelToXML(s)
-----	enc := xml.NewEncoder(w)
-----	enc.Indent("", "  ")
-----	if err := enc.Encode(raw); err != nil {
-----		return fmt.Errorf("scl: generate: %w", err)
-----	}
-----	if _, err := io.WriteString(w, "\n"); err != nil {
-----		return fmt.Errorf("scl: generate: %w", err)
-----	}
-----	return nil
-----}
-----
-----func modelToXML(s *SCL) *xmlSCL {
-----	raw := &xmlSCL{
-----		XMLName: xml.Name{Local: "SCL", Space: "http://www.iec.ch/61850/2003/SCL"},
-----		Header: xmlHeader{
-----			ID:       s.Header.ID,
-----			Version:  s.Header.Version,
-----			Revision: s.Header.Revision,
-----		},
-----	}
-----
-----	for _, sub := range s.Substations {
-----		raw.Substations = append(raw.Substations, substationToXML(sub))
-----	}
-----
-----	if s.Communication != nil {
-----		raw.Communication = communicationToXML(s.Communication)
-----	}
-----
-----	for _, ied := range s.IEDs {
-----		raw.IEDs = append(raw.IEDs, iedToXML(ied))
-----	}
-----
-----	raw.DataTypeTemplates = dttToXML(s.DataTypeTemplates)
-----
-----	return raw
-----}
-----
-----func substationToXML(sub Substation) xmlSubstation {
-----	raw := xmlSubstation{Name: sub.Name, Desc: sub.Desc}
-----	for _, vl := range sub.VoltageLevels {
-----		rawVL := xmlVoltageLevel{Name: vl.Name, Desc: vl.Desc}
-----		if vl.Voltage != "" {
-----			rawVL.Voltage = &xmlVal{Value: vl.Voltage}
-----		}
-----		for _, bay := range vl.Bays {
-----			rawBay := xmlBay{Name: bay.Name, Desc: bay.Desc}
-----			for _, ce := range bay.ConductingEquipments {
-----				rawBay.ConductingEquipments = append(rawBay.ConductingEquipments, xmlConductingEquipment(ce))
-----			}
-----			rawVL.Bays = append(rawVL.Bays, rawBay)
-----		}
-----		raw.VoltageLevels = append(raw.VoltageLevels, rawVL)
-----	}
-----	return raw
-----}
-----
-----func communicationToXML(comm *Communication) *xmlCommunication {
-----	raw := &xmlCommunication{}
-----	for _, sn := range comm.SubNetworks {
-----		rawSN := xmlSubNetwork{Name: sn.Name, Desc: sn.Desc, Type: sn.Type}
-----		for _, cap := range sn.ConnectedAPs {
-----			rawAP := xmlConnectedAP{IEDName: cap.IEDName, APName: cap.APName}
-----			if len(cap.Address) > 0 {
-----				rawAP.Address = &xmlAddress{Ps: psToXML(cap.Address)}
-----			}
-----			for _, gse := range cap.GSEs {
-----				rawGSE := xmlGSE{LDInst: gse.LDInst, CBName: gse.CBName}
-----				if len(gse.Address) > 0 {
-----					rawGSE.Address = &xmlAddress{Ps: psToXML(gse.Address)}
-----				}
-----				if gse.MinTime != "" {
-----					rawGSE.MinTime = &xmlVal{Value: gse.MinTime}
-----				}
-----				if gse.MaxTime != "" {
-----					rawGSE.MaxTime = &xmlVal{Value: gse.MaxTime}
-----				}
-----				rawAP.GSEs = append(rawAP.GSEs, rawGSE)
-----			}
-----			for _, smv := range cap.SMVs {
-----				rawSMV := xmlSMV{LDInst: smv.LDInst, CBName: smv.CBName}
-----				if len(smv.Address) > 0 {
-----					rawSMV.Address = &xmlAddress{Ps: psToXML(smv.Address)}
-----				}
-----				rawAP.SMVs = append(rawAP.SMVs, rawSMV)
-----			}
-----			rawSN.ConnectedAPs = append(rawSN.ConnectedAPs, rawAP)
-----		}
-----		raw.SubNetworks = append(raw.SubNetworks, rawSN)
-----	}
-----	return raw
-----}
-----
-----func psToXML(ps []P) []xmlP {
-----	raw := make([]xmlP, len(ps))
-----	for i, p := range ps {
