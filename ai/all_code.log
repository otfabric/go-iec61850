package scl

import "fmt"

// ValidationSeverity indicates the severity of a validation finding.
type ValidationSeverity int

const (
	// SeverityError indicates an error that likely prevents correct
	// operation.
	SeverityError ValidationSeverity = iota

	// SeverityWarning indicates a potential issue that may not
	// prevent operation.
	SeverityWarning
)

// String returns "error" or "warning".
func (s ValidationSeverity) String() string {
	if s == SeverityWarning {
		return "warning"
	}
	return "error"
}

// ValidationFinding represents a single validation issue found in
// an SCL model.
type ValidationFinding struct {
	Severity ValidationSeverity
	Path     string
	Message  string
}

// Error implements the error interface.
func (f ValidationFinding) Error() string {
	return fmt.Sprintf("[%s] %s: %s", f.Severity, f.Path, f.Message)
}

// Validate performs semantic validation on an SCL model beyond basic
// parsing. It checks cross-references, type chains, and logical
// consistency.
//
// Returns a (possibly empty) list of findings. The list is not
// exhaustive — validation stops checking dependent chains when a
// root reference is missing.
func Validate(s *SCL) []ValidationFinding {
	v := &validator{
		lntIndex:  make(map[string]bool),
		dotIndex:  make(map[string]bool),
		datIndex:  make(map[string]bool),
		enumIndex: make(map[string]bool),
	}

	v.buildIndexes(s)
	v.validateTypeTemplates(s)
	v.validateIEDs(s)
	v.validateCommunication(s)

	return v.findings
}

type validator struct {
	findings  []ValidationFinding
	lntIndex  map[string]bool
	dotIndex  map[string]bool
	datIndex  map[string]bool
	enumIndex map[string]bool
}

func (v *validator) buildIndexes(s *SCL) {
	for _, lnt := range s.DataTypeTemplates.LNodeTypes {
		if v.lntIndex[lnt.ID] {
			v.addError("LNodeType", fmt.Sprintf("duplicate ID %q", lnt.ID))
		}
		v.lntIndex[lnt.ID] = true
	}
	for _, dot := range s.DataTypeTemplates.DOTypes {
		if v.dotIndex[dot.ID] {
			v.addError("DOType", fmt.Sprintf("duplicate ID %q", dot.ID))
		}
		v.dotIndex[dot.ID] = true
	}
	for _, dat := range s.DataTypeTemplates.DATypes {
		if v.datIndex[dat.ID] {
			v.addError("DAType", fmt.Sprintf("duplicate ID %q", dat.ID))
		}
		v.datIndex[dat.ID] = true
	}
	for _, et := range s.DataTypeTemplates.EnumTypes {
		if v.enumIndex[et.ID] {
			v.addError("EnumType", fmt.Sprintf("duplicate ID %q", et.ID))
		}
		v.enumIndex[et.ID] = true
	}

	iedNames := make(map[string]bool)
	for _, ied := range s.IEDs {
		if iedNames[ied.Name] {
			v.addError("IED", fmt.Sprintf("duplicate name %q", ied.Name))
		}
		iedNames[ied.Name] = true
	}
}

func (v *validator) addError(path, msg string) {
	v.findings = append(v.findings, ValidationFinding{
		Severity: SeverityError, Path: path, Message: msg,
	})
}

func (v *validator) addWarning(path, msg string) {
	v.findings = append(v.findings, ValidationFinding{
		Severity: SeverityWarning, Path: path, Message: msg,
	})
}

func (v *validator) validateTypeTemplates(s *SCL) {
	for _, lnt := range s.DataTypeTemplates.LNodeTypes {
		path := fmt.Sprintf("LNodeType[%s]", lnt.ID)
		for _, do := range lnt.DOs {
			if !v.dotIndex[do.Type] {
				v.addError(path+".DO["+do.Name+"]",
					fmt.Sprintf("references DOType %q which does not exist", do.Type))
			}
		}
	}

	for _, dot := range s.DataTypeTemplates.DOTypes {
		path := fmt.Sprintf("DOType[%s]", dot.ID)
		for _, da := range dot.DAs {
			v.validateDATypeRef(path+".DA["+da.Name+"]", da.BType, da.Type)
		}
		for _, sdo := range dot.SDOs {
			if !v.dotIndex[sdo.Type] {
				v.addError(path+".SDO["+sdo.Name+"]",
					fmt.Sprintf("references DOType %q which does not exist", sdo.Type))
			}
		}
	}

	for _, dat := range s.DataTypeTemplates.DATypes {
		path := fmt.Sprintf("DAType[%s]", dat.ID)
		for _, bda := range dat.BDAs {
			v.validateDATypeRef(path+".BDA["+bda.Name+"]", bda.BType, bda.Type)
		}
	}
}

func (v *validator) validateDATypeRef(path, bType, typRef string) {
	if typRef == "" {
		return
	}
	switch bType {
	case "Struct":
		if !v.datIndex[typRef] {
			v.addError(path, fmt.Sprintf("references DAType %q which does not exist", typRef))
		}
	case "Enum":
		if !v.enumIndex[typRef] {
			v.addError(path, fmt.Sprintf("references EnumType %q which does not exist", typRef))
		}
	}
}

func (v *validator) validateIEDs(s *SCL) {
	for _, ied := range s.IEDs {
		iedPath := fmt.Sprintf("IED[%s]", ied.Name)

		apNames := make(map[string]bool)
		for _, ap := range ied.AccessPoints {
			if apNames[ap.Name] {
				v.addError(iedPath, fmt.Sprintf("duplicate AccessPoint name %q", ap.Name))
			}
			apNames[ap.Name] = true
		}

		ldInsts := make(map[string]bool)
		for _, ap := range ied.AccessPoints {
			if ap.Server == nil {
				continue
			}
			for _, ld := range ap.Server.LDevices {
				if ldInsts[ld.Inst] {
					v.addError(iedPath, fmt.Sprintf("duplicate LDevice instance %q", ld.Inst))
				}
				ldInsts[ld.Inst] = true

				ldPath := iedPath + "/LD[" + ld.Inst + "]"
				if ld.LN0 != nil {
					v.validateLN(ldPath, *ld.LN0)
				}
				for _, ln := range ld.LNs {
					v.validateLN(ldPath, ln)
				}
			}
		}
	}
}

func (v *validator) validateLN(ldPath string, ln LN) {
	lnName := ln.Prefix + ln.LNClass + ln.Inst
	lnPath := ldPath + "/LN[" + lnName + "]"

	if !v.lntIndex[ln.LNType] {
		v.addError(lnPath, fmt.Sprintf("references LNodeType %q which does not exist", ln.LNType))
	}

	dsNames := make(map[string]bool)
	for _, ds := range ln.DataSets {
		dsNames[ds.Name] = true
	}

	for _, rc := range ln.Reports {
		if rc.DatSet != "" && !dsNames[rc.DatSet] {
			v.addError(lnPath+"/RC["+rc.Name+"]",
				fmt.Sprintf("references datSet %q which is not defined in this LN (cross-LN dataset references are not supported by the server model)", rc.DatSet))
		}
	}
}

func (v *validator) validateCommunication(s *SCL) {
	if s.Communication == nil {
		return
	}

	// Build IED → AP → LD index for cross-checking
	type iedInfo struct {
		aps map[string]bool
		lds map[string]bool
	}
	iedIndex := make(map[string]*iedInfo)
	for _, ied := range s.IEDs {
		info := &iedInfo{
			aps: make(map[string]bool),
			lds: make(map[string]bool),
		}
		for _, ap := range ied.AccessPoints {
			info.aps[ap.Name] = true
			if ap.Server != nil {
				for _, ld := range ap.Server.LDevices {
					info.lds[ld.Inst] = true
				}
			}
		}
		iedIndex[ied.Name] = info
	}

	for _, sn := range s.Communication.SubNetworks {
		snPath := fmt.Sprintf("SubNetwork[%s]", sn.Name)
		for _, cap := range sn.ConnectedAPs {
			capPath := snPath + "/ConnectedAP[" + cap.IEDName + "/" + cap.APName + "]"
			info, iedExists := iedIndex[cap.IEDName]
			if !iedExists {
				v.addError(capPath, fmt.Sprintf("references IED %q which does not exist", cap.IEDName))
				continue
			}
			if !info.aps[cap.APName] {
				v.addError(capPath, fmt.Sprintf("references AccessPoint %q which does not exist in IED %q",
					cap.APName, cap.IEDName))
			}

			for _, gse := range cap.GSEs {
				gsePath := capPath + "/GSE[" + gse.CBName + "]"
				if gse.LDInst != "" && !info.lds[gse.LDInst] {
					v.addWarning(gsePath, fmt.Sprintf(
						"references LDevice %q which does not exist in IED %q", gse.LDInst, cap.IEDName))
				}
			}
			for _, smv := range cap.SMVs {
				smvPath := capPath + "/SMV[" + smv.CBName + "]"
				if smv.LDInst != "" && !info.lds[smv.LDInst] {
					v.addWarning(smvPath, fmt.Sprintf(
						"references LDevice %q which does not exist in IED %q", smv.LDInst, cap.IEDName))
				}
			}
		}
	}
}

