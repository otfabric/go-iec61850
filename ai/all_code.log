package scl

import (
	"encoding/xml"
	"fmt"
	"io"
	"strconv"
)

// Generate writes an SCL model as XML to the given writer.
//
// The output is deterministic: elements appear in the order they are
// stored in the model slices. Round-trip loss is minimal for the
// supported SCL subset (Header, Substation, Communication, IED,
// DataTypeTemplates).
func Generate(w io.Writer, s *SCL) error {
	if _, err := io.WriteString(w, xml.Header); err != nil {
		return fmt.Errorf("scl: generate: %w", err)
	}

	raw := modelToXML(s)
	enc := xml.NewEncoder(w)
	enc.Indent("", "  ")
	if err := enc.Encode(raw); err != nil {
		return fmt.Errorf("scl: generate: %w", err)
	}
	if _, err := io.WriteString(w, "\n"); err != nil {
		return fmt.Errorf("scl: generate: %w", err)
	}
	return nil
}

func modelToXML(s *SCL) *xmlSCL {
	raw := &xmlSCL{
		XMLName: xml.Name{Local: "SCL", Space: "http://www.iec.ch/61850/2003/SCL"},
		Header: xmlHeader{
			ID:       s.Header.ID,
			Version:  s.Header.Version,
			Revision: s.Header.Revision,
		},
	}

	for _, sub := range s.Substations {
		raw.Substations = append(raw.Substations, substationToXML(sub))
	}

	if s.Communication != nil {
		raw.Communication = communicationToXML(s.Communication)
	}

	for _, ied := range s.IEDs {
		raw.IEDs = append(raw.IEDs, iedToXML(ied))
	}

	raw.DataTypeTemplates = dttToXML(s.DataTypeTemplates)

	return raw
}

func substationToXML(sub Substation) xmlSubstation {
	raw := xmlSubstation{Name: sub.Name, Desc: sub.Desc}
	for _, vl := range sub.VoltageLevels {
		rawVL := xmlVoltageLevel{Name: vl.Name, Desc: vl.Desc}
		if vl.Voltage != "" {
			rawVL.Voltage = &xmlVal{Value: vl.Voltage}
		}
		for _, bay := range vl.Bays {
			rawBay := xmlBay{Name: bay.Name, Desc: bay.Desc}
			for _, ce := range bay.ConductingEquipments {
				rawBay.ConductingEquipments = append(rawBay.ConductingEquipments, xmlConductingEquipment(ce))
			}
			rawVL.Bays = append(rawVL.Bays, rawBay)
		}
		raw.VoltageLevels = append(raw.VoltageLevels, rawVL)
	}
	return raw
}

func communicationToXML(comm *Communication) *xmlCommunication {
	raw := &xmlCommunication{}
	for _, sn := range comm.SubNetworks {
		rawSN := xmlSubNetwork{Name: sn.Name, Desc: sn.Desc, Type: sn.Type}
		for _, cap := range sn.ConnectedAPs {
			rawAP := xmlConnectedAP{IEDName: cap.IEDName, APName: cap.APName}
			if len(cap.Address) > 0 {
				rawAP.Address = &xmlAddress{Ps: psToXML(cap.Address)}
			}
			for _, gse := range cap.GSEs {
				rawGSE := xmlGSE{LDInst: gse.LDInst, CBName: gse.CBName}
				if len(gse.Address) > 0 {
					rawGSE.Address = &xmlAddress{Ps: psToXML(gse.Address)}
				}
				if gse.MinTime != "" {
					rawGSE.MinTime = &xmlVal{Value: gse.MinTime}
				}
				if gse.MaxTime != "" {
					rawGSE.MaxTime = &xmlVal{Value: gse.MaxTime}
				}
				rawAP.GSEs = append(rawAP.GSEs, rawGSE)
			}
			for _, smv := range cap.SMVs {
				rawSMV := xmlSMV{LDInst: smv.LDInst, CBName: smv.CBName}
				if len(smv.Address) > 0 {
					rawSMV.Address = &xmlAddress{Ps: psToXML(smv.Address)}
				}
				rawAP.SMVs = append(rawAP.SMVs, rawSMV)
			}
			rawSN.ConnectedAPs = append(rawSN.ConnectedAPs, rawAP)
		}
		raw.SubNetworks = append(raw.SubNetworks, rawSN)
	}
	return raw
}

func psToXML(ps []P) []xmlP {
	raw := make([]xmlP, len(ps))
	for i, p := range ps {
		raw[i] = xmlP(p)
	}
	return raw
}

func iedToXML(ied IED) xmlIED {
	raw := xmlIED{
		Name:         ied.Name,
		Desc:         ied.Desc,
		Manufacturer: ied.Manufacturer,
		Type:         ied.Type,
	}
	if ied.Services != nil {
		raw.Services = servicesToXML(ied.Services)
	}
	for _, ap := range ied.AccessPoints {
		rawAP := xmlAccessPoint{Name: ap.Name}
		if ap.Server != nil {
			rawSrv := &xmlServer{}
			for _, ld := range ap.Server.LDevices {
				rawSrv.LDevices = append(rawSrv.LDevices, ldToXML(ld))
			}
			rawAP.Server = rawSrv
		}
		raw.AccessPoints = append(raw.AccessPoints, rawAP)
	}
	return raw
}

func ldToXML(ld LDevice) xmlLDevice {
	raw := xmlLDevice{Inst: ld.Inst, Desc: ld.Desc}
	if ld.LN0 != nil {
		ln := lnToXML(*ld.LN0)
		raw.LN0 = &ln
	}
	for _, ln := range ld.LNs {
		raw.LNs = append(raw.LNs, lnToXML(ln))
	}
	return raw
}

func lnToXML(ln LN) xmlLN {
	raw := xmlLN{
		Prefix: ln.Prefix, LNClass: ln.LNClass,
		Inst: ln.Inst, LNType: ln.LNType, Desc: ln.Desc,
	}
	for _, doi := range ln.DOIs {
		raw.DOIs = append(raw.DOIs, doiToXML(doi))
	}
	for _, ds := range ln.DataSets {
		raw.DataSets = append(raw.DataSets, dsToXML(ds))
	}
	for _, rc := range ln.Reports {
		raw.Reports = append(raw.Reports, rcToXML(rc))
	}
	for _, lg := range ln.Logs {
		raw.Logs = append(raw.Logs, xmlLog(lg))
	}
	return raw
}

func doiToXML(doi DOI) xmlDOI {
	raw := xmlDOI{Name: doi.Name, Desc: doi.Desc}
	for _, dai := range doi.DAIs {
		raw.DAIs = append(raw.DAIs, xmlDAI(dai))
	}
	for _, sdi := range doi.SDIs {
		raw.SDIs = append(raw.SDIs, sdiToXML(sdi))
	}
	return raw
}

func sdiToXML(sdi SDI) xmlSDI {
	raw := xmlSDI{Name: sdi.Name}
	for _, dai := range sdi.DAIs {
		raw.DAIs = append(raw.DAIs, xmlDAI(dai))
	}
	for _, sub := range sdi.SDIs {
		raw.SDIs = append(raw.SDIs, sdiToXML(sub))
	}
	return raw
}

func dsToXML(ds DataSet) xmlDataSet {
	raw := xmlDataSet{Name: ds.Name, Desc: ds.Desc}
	for _, f := range ds.FCDAs {
		raw.FCDAs = append(raw.FCDAs, xmlFCDA(f))
	}
	return raw
}

func rcToXML(rc ReportControl) xmlReportControl {
	raw := xmlReportControl{
		Name:   rc.Name,
		Desc:   rc.Desc,
		RptID:  rc.RptID,
		DatSet: rc.DatSet,
	}
	if rc.ConfRev > 0 {
		raw.ConfRev = strconv.FormatUint(uint64(rc.ConfRev), 10)
	}
	if rc.Buffered {
		raw.Buffered = "true"
	}
	if rc.BufTime > 0 {
		raw.BufTime = strconv.FormatUint(uint64(rc.BufTime), 10)
	}
	if rc.IntgPd > 0 {
		raw.IntgPd = strconv.FormatUint(uint64(rc.IntgPd), 10)
	}
	raw.TrgOps = &xmlTrgOps{
		Dchg: boolStr(rc.TrgOps.Dchg), Qchg: boolStr(rc.TrgOps.Qchg),
		Dupd: boolStr(rc.TrgOps.Dupd), Period: boolStr(rc.TrgOps.Period),
		GI: boolStr(rc.TrgOps.GI),
	}
	raw.OptFields = &xmlOptFields{
		SeqNum: boolStr(rc.OptFields.SeqNum), TimeStamp: boolStr(rc.OptFields.TimeStamp),
		DataSet: boolStr(rc.OptFields.DataSet), ReasonCode: boolStr(rc.OptFields.ReasonCode),
		DataRef: boolStr(rc.OptFields.DataRef), EntryID: boolStr(rc.OptFields.EntryID),
		ConfigRef: boolStr(rc.OptFields.ConfigRef), BufOvfl: boolStr(rc.OptFields.BufOvfl),
	}
	return raw
}

func boolStr(b bool) string {
	if b {
		return "true"
	}
	return "false"
}

func dttToXML(dtt DataTypeTemplates) xmlDataTypeTemplates {
	raw := xmlDataTypeTemplates{}
	for _, lnt := range dtt.LNodeTypes {
		rawLNT := xmlLNodeType{ID: lnt.ID, LNClass: lnt.LNClass, Desc: lnt.Desc}
		for _, do := range lnt.DOs {
			rawLNT.DOs = append(rawLNT.DOs, xmlDO(do))
		}
		raw.LNodeTypes = append(raw.LNodeTypes, rawLNT)
	}
	for _, dot := range dtt.DOTypes {
		rawDOT := xmlDOType{ID: dot.ID, CDC: dot.CDC, Desc: dot.Desc}
		for _, da := range dot.DAs {
			rawDA := xmlDA{
				Name: da.Name, FC: da.FC, BType: da.BType,
				Type: da.Type, Desc: da.Desc, Val: da.Val,
			}
			if da.Count > 0 {
				rawDA.Count = strconv.Itoa(da.Count)
			}
			rawDOT.DAs = append(rawDOT.DAs, rawDA)
		}
		for _, sdo := range dot.SDOs {
			rawDOT.SDOs = append(rawDOT.SDOs, xmlSDO(sdo))
		}
		raw.DOTypes = append(raw.DOTypes, rawDOT)
	}
	for _, dat := range dtt.DATypes {
		rawDAT := xmlDAType{ID: dat.ID, Desc: dat.Desc}
		for _, bda := range dat.BDAs {
			rawBDA := xmlBDA{
				Name: bda.Name, BType: bda.BType, Type: bda.Type,
				Desc: bda.Desc, Val: bda.Val,
			}
			if bda.Count > 0 {
				rawBDA.Count = strconv.Itoa(bda.Count)
			}
			rawDAT.BDAs = append(rawDAT.BDAs, rawBDA)
		}
		raw.DATypes = append(raw.DATypes, rawDAT)
	}
	for _, et := range dtt.EnumTypes {
		rawET := xmlEnumType{ID: et.ID, Desc: et.Desc}
		for _, ev := range et.Vals {
			rawET.Vals = append(rawET.Vals, xmlEnumVal{
				Ord: strconv.Itoa(ev.Ord), Desc: ev.Value,
			})
		}
		raw.EnumTypes = append(raw.EnumTypes, rawET)
	}
	return raw
}

func servicesToXML(svc *Services) *xmlServices {
	raw := &xmlServices{}
	if svc.DynAssociation {
		raw.DynAssociation = &struct{}{}
	}
	if svc.GetDirectory {
		raw.GetDirectory = &struct{}{}
	}
	if svc.GetDataObjectDefinition {
		raw.GetDataObjectDefinition = &struct{}{}
	}
	if svc.GetDataSetValue {
		raw.GetDataSetValue = &struct{}{}
	}
	if svc.DataSetDirectory {
		raw.DataSetDirectory = &struct{}{}
	}
	if svc.ReadWrite {
		raw.ReadWrite = &struct{}{}
	}
	if svc.GetCBValues {
		raw.GetCBValues = &struct{}{}
	}
	if svc.FileHandling {
		raw.FileHandling = &struct{}{}
	}
	if svc.ConfDataSet != nil {
		raw.ConfDataSet = &xmlConfDataSet{
			Max:           strconv.Itoa(svc.ConfDataSet.Max),
			MaxAttributes: strconv.Itoa(svc.ConfDataSet.MaxAttributes),
			Modify:        boolStr(svc.ConfDataSet.Modify),
		}
	}
	if svc.ConfReportCtrl != nil {
		raw.ConfReportCtrl = &xmlConfReportControl{
			Max:     strconv.Itoa(svc.ConfReportCtrl.Max),
			BufMode: svc.ConfReportCtrl.BufMode,
		}
	}
	if svc.ReportSettings != nil {
		raw.ReportSettings = &xmlReportSettings{
			CBName:    svc.ReportSettings.CBName,
			DatSet:    svc.ReportSettings.DatSet,
			RptID:     svc.ReportSettings.RptID,
			OptFields: svc.ReportSettings.OptFields,
			BufTime:   svc.ReportSettings.BufTime,
			TrgOps:    svc.ReportSettings.TrgOps,
			IntgPd:    svc.ReportSettings.IntgPd,
		}
	}
	if svc.ConfLNs != nil {
		raw.ConfLNs = &xmlConfLNs{
			FixPrefix: boolStr(svc.ConfLNs.FixPrefix),
			FixLnInst: boolStr(svc.ConfLNs.FixLnInst),
		}
	}
	if svc.GOOSE != nil {
		raw.GOOSE = &xmlGOOSEService{
			Max:       strconv.Itoa(svc.GOOSE.Max),
			FixedOffs: boolStr(svc.GOOSE.FixedOffs),
		}
	}
	if svc.SMVsc != nil {
		raw.SMVsc = &xmlSMVService{
			Max: strconv.Itoa(svc.SMVsc.Max),
		}
	}
	return raw
}

