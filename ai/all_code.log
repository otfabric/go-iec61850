package scl

import (
	"encoding/xml"
	"fmt"
	"io"
	"os"
	"strconv"
	"strings"
)

// Parse reads an SCL XML document from r and returns the parsed model.
// Supports SCD, ICD, CID, and IID file formats.
func Parse(r io.Reader) (*SCL, error) {
	var raw xmlSCL
	dec := xml.NewDecoder(r)
	if err := dec.Decode(&raw); err != nil {
		return nil, fmt.Errorf("scl: parse: %w", err)
	}
	return convertSCL(&raw)
}

// ParseFile reads and parses an SCL XML file from the given path.
func ParseFile(path string) (*SCL, error) {
	f, err := os.Open(path)
	if err != nil {
		return nil, fmt.Errorf("scl: open %q: %w", path, err)
	}
	defer func() { _ = f.Close() }()
	return Parse(f)
}

// --- XML mapping types ---

type xmlSCL struct {
	XMLName           xml.Name             `xml:"SCL"`
	Header            xmlHeader            `xml:"Header"`
	Substations       []xmlSubstation      `xml:"Substation"`
	Communication     *xmlCommunication    `xml:"Communication"`
	IEDs              []xmlIED             `xml:"IED"`
	DataTypeTemplates xmlDataTypeTemplates `xml:"DataTypeTemplates"`
}

type xmlHeader struct {
	ID       string `xml:"id,attr"`
	Version  string `xml:"version,attr"`
	Revision string `xml:"revision,attr"`
}

type xmlIED struct {
	Name         string           `xml:"name,attr"`
	Desc         string           `xml:"desc,attr"`
	Manufacturer string           `xml:"manufacturer,attr"`
	Type         string           `xml:"type,attr"`
	Services     *xmlServices     `xml:"Services"`
	AccessPoints []xmlAccessPoint `xml:"AccessPoint"`
}

// --- Substation XML types ---

type xmlSubstation struct {
	Name          string            `xml:"name,attr"`
	Desc          string            `xml:"desc,attr"`
	VoltageLevels []xmlVoltageLevel `xml:"VoltageLevel"`
}

type xmlVoltageLevel struct {
	Name    string   `xml:"name,attr"`
	Desc    string   `xml:"desc,attr"`
	Voltage *xmlVal  `xml:"Voltage"`
	Bays    []xmlBay `xml:"Bay"`
}

type xmlVal struct {
	Value string `xml:",chardata"`
}

type xmlBay struct {
	Name                 string                   `xml:"name,attr"`
	Desc                 string                   `xml:"desc,attr"`
	ConductingEquipments []xmlConductingEquipment `xml:"ConductingEquipment"`
}

type xmlConductingEquipment struct {
	Name string `xml:"name,attr"`
	Type string `xml:"type,attr"`
	Desc string `xml:"desc,attr"`
}

// --- Communication XML types ---

type xmlCommunication struct {
	SubNetworks []xmlSubNetwork `xml:"SubNetwork"`
}

type xmlSubNetwork struct {
	Name         string           `xml:"name,attr"`
	Desc         string           `xml:"desc,attr"`
	Type         string           `xml:"type,attr"`
	ConnectedAPs []xmlConnectedAP `xml:"ConnectedAP"`
}

type xmlConnectedAP struct {
	IEDName string      `xml:"iedName,attr"`
	APName  string      `xml:"apName,attr"`
	Address *xmlAddress `xml:"Address"`
	GSEs    []xmlGSE    `xml:"GSE"`
	SMVs    []xmlSMV    `xml:"SMV"`
}

type xmlAddress struct {
	Ps []xmlP `xml:"P"`
}

type xmlP struct {
	Type  string `xml:"type,attr"`
	Value string `xml:",chardata"`
}

type xmlGSE struct {
	LDInst  string      `xml:"ldInst,attr"`
	CBName  string      `xml:"cbName,attr"`
	Address *xmlAddress `xml:"Address"`
	MinTime *xmlVal     `xml:"MinTime"`
	MaxTime *xmlVal     `xml:"MaxTime"`
}

type xmlSMV struct {
	LDInst  string      `xml:"ldInst,attr"`
	CBName  string      `xml:"cbName,attr"`
	Address *xmlAddress `xml:"Address"`
}

// --- Services XML types ---

type xmlServices struct {
	DynAssociation          *struct{} `xml:"DynAssociation"`
	GetDirectory            *struct{} `xml:"GetDirectory"`
	GetDataObjectDefinition *struct{} `xml:"GetDataObjectDefinition"`
	GetDataSetValue         *struct{} `xml:"GetDataSetValue"`
	DataSetDirectory        *struct{} `xml:"DataSetDirectory"`
	ReadWrite               *struct{} `xml:"ReadWrite"`
	GetCBValues             *struct{} `xml:"GetCBValues"`
	FileHandling            *struct{} `xml:"FileHandling"`

	ConfDataSet    *xmlConfDataSet       `xml:"ConfDataSet"`
	ConfReportCtrl *xmlConfReportControl `xml:"ConfReportControl"`
	ReportSettings *xmlReportSettings    `xml:"ReportSettings"`
	ConfLNs        *xmlConfLNs           `xml:"ConfLNs"`
	GOOSE          *xmlGOOSEService      `xml:"GOOSE"`
	SMVsc          *xmlSMVService        `xml:"SMVsc"`
}

type xmlConfDataSet struct {
	Max           string `xml:"max,attr"`
	MaxAttributes string `xml:"maxAttributes,attr"`
	Modify        string `xml:"modify,attr"`
}

type xmlConfReportControl struct {
	Max     string `xml:"max,attr"`
	BufMode string `xml:"bufMode,attr"`
}

type xmlReportSettings struct {
	CBName    string `xml:"cbName,attr"`
	DatSet    string `xml:"datSet,attr"`
	RptID     string `xml:"rptID,attr"`
	OptFields string `xml:"optFields,attr"`
	BufTime   string `xml:"bufTime,attr"`
	TrgOps    string `xml:"trgOps,attr"`
	IntgPd    string `xml:"intgPd,attr"`
}

type xmlConfLNs struct {
	FixPrefix string `xml:"fixPrefix,attr"`
	FixLnInst string `xml:"fixLnInst,attr"`
}

type xmlGOOSEService struct {
	Max       string `xml:"max,attr"`
	FixedOffs string `xml:"fixedOffs,attr"`
}

type xmlSMVService struct {
	Max string `xml:"max,attr"`
}

type xmlAccessPoint struct {
	Name   string     `xml:"name,attr"`
	Server *xmlServer `xml:"Server"`
}

type xmlServer struct {
	LDevices []xmlLDevice `xml:"LDevice"`
}

type xmlLDevice struct {
	Inst string  `xml:"inst,attr"`
	Desc string  `xml:"desc,attr"`
	LN0  *xmlLN  `xml:"LN0"`
	LNs  []xmlLN `xml:"LN"`
}

type xmlLN struct {
	Prefix  string `xml:"prefix,attr"`
	LNClass string `xml:"lnClass,attr"`
	Inst    string `xml:"inst,attr"`
	LNType  string `xml:"lnType,attr"`
	Desc    string `xml:"desc,attr"`

	DOIs           []xmlDOI           `xml:"DOI"`
	DataSets       []xmlDataSet       `xml:"DataSet"`
	Reports        []xmlReportControl `xml:"ReportControl"`
	Logs           []xmlLog           `xml:"LogControl"`
	SettingControl *xmlSettingControl `xml:"SettingControl"`
}

type xmlSettingControl struct {
	NumOfSGs uint8  `xml:"numOfSGs,attr"`
	ActSG    uint8  `xml:"actSG,attr"`
	ResvTms  uint16 `xml:"resvTms,attr"`
}

type xmlDOI struct {
	Name string   `xml:"name,attr"`
	Desc string   `xml:"desc,attr"`
	DAIs []xmlDAI `xml:"DAI"`
	SDIs []xmlSDI `xml:"SDI"`
}

type xmlSDI struct {
	Name string   `xml:"name,attr"`
	DAIs []xmlDAI `xml:"DAI"`
	SDIs []xmlSDI `xml:"SDI"`
}

type xmlDAI struct {
	Name  string `xml:"name,attr"`
	SAddr string `xml:"sAddr,attr"`
	Val   string `xml:"Val"`
}

type xmlDataSet struct {
	Name  string    `xml:"name,attr"`
	Desc  string    `xml:"desc,attr"`
	FCDAs []xmlFCDA `xml:"FCDA"`
}

type xmlFCDA struct {
	LDInst  string `xml:"ldInst,attr"`
	Prefix  string `xml:"prefix,attr"`
	LNClass string `xml:"lnClass,attr"`
	LNInst  string `xml:"lnInst,attr"`
	DOName  string `xml:"doName,attr"`
	DAName  string `xml:"daName,attr"`
	FC      string `xml:"fc,attr"`
}

type xmlReportControl struct {
	Name      string        `xml:"name,attr"`
	Desc      string        `xml:"desc,attr"`
	RptID     string        `xml:"rptID,attr"`
	DatSet    string        `xml:"datSet,attr"`
	ConfRev   string        `xml:"confRev,attr"`
	Buffered  string        `xml:"buffered,attr"`
	BufTime   string        `xml:"bufTime,attr"`
	IntgPd    string        `xml:"intgPd,attr"`
	TrgOps    *xmlTrgOps    `xml:"TrgOps"`
	OptFields *xmlOptFields `xml:"OptFields"`
}

type xmlTrgOps struct {
	Dchg   string `xml:"dchg,attr"`
	Qchg   string `xml:"qchg,attr"`
	Dupd   string `xml:"dupd,attr"`
	Period string `xml:"period,attr"`
	GI     string `xml:"gi,attr"`
}

type xmlOptFields struct {
	SeqNum     string `xml:"seqNum,attr"`
	TimeStamp  string `xml:"timeStamp,attr"`
	DataSet    string `xml:"dataSet,attr"`
	ReasonCode string `xml:"reasonCode,attr"`
	DataRef    string `xml:"dataRef,attr"`
	EntryID    string `xml:"entryID,attr"`
	ConfigRef  string `xml:"configRef,attr"`
	BufOvfl    string `xml:"bufOvfl,attr"`
}

type xmlLog struct {
	Name string `xml:"name,attr"`
	Desc string `xml:"desc,attr"`
}

type xmlDataTypeTemplates struct {
	LNodeTypes []xmlLNodeType `xml:"LNodeType"`
	DOTypes    []xmlDOType    `xml:"DOType"`
	DATypes    []xmlDAType    `xml:"DAType"`
	EnumTypes  []xmlEnumType  `xml:"EnumType"`
}

type xmlLNodeType struct {
	ID      string  `xml:"id,attr"`
	LNClass string  `xml:"lnClass,attr"`
	Desc    string  `xml:"desc,attr"`
	DOs     []xmlDO `xml:"DO"`
}

type xmlDO struct {
	Name string `xml:"name,attr"`
	Type string `xml:"type,attr"`
	Desc string `xml:"desc,attr"`
}

type xmlDOType struct {
	ID   string   `xml:"id,attr"`
	CDC  string   `xml:"cdc,attr"`
	Desc string   `xml:"desc,attr"`
	DAs  []xmlDA  `xml:"DA"`
	SDOs []xmlSDO `xml:"SDO"`
}

type xmlSDO struct {
	Name string `xml:"name,attr"`
	Type string `xml:"type,attr"`
	Desc string `xml:"desc,attr"`
}

type xmlDA struct {
	Name  string `xml:"name,attr"`
	FC    string `xml:"fc,attr"`
	BType string `xml:"bType,attr"`
	Type  string `xml:"type,attr"`
	Desc  string `xml:"desc,attr"`
	Count string `xml:"count,attr"`
	Val   string `xml:"Val"`
}

type xmlDAType struct {
	ID   string   `xml:"id,attr"`
	Desc string   `xml:"desc,attr"`
	BDAs []xmlBDA `xml:"BDA"`
}

type xmlBDA struct {
	Name  string `xml:"name,attr"`
	BType string `xml:"bType,attr"`
	Type  string `xml:"type,attr"`
	Desc  string `xml:"desc,attr"`
	Count string `xml:"count,attr"`
	Val   string `xml:"Val"`
}

type xmlEnumType struct {
	ID   string       `xml:"id,attr"`
	Desc string       `xml:"desc,attr"`
	Vals []xmlEnumVal `xml:"EnumVal"`
}

type xmlEnumVal struct {
	Ord  string `xml:"ord,attr"`
	Desc string `xml:",chardata"`
}

// parseBool interprets an SCL boolean attribute. It normalises
// case and surrounding whitespace, accepting "true"/"false" (and
// variants such as "True", " TRUE "). An empty string is treated as
// false. Anything else returns an error.
func parseBool(s string) (bool, error) {
	s = strings.TrimSpace(strings.ToLower(s))
	switch s {
	case "true":
		return true, nil
	case "", "false":
		return false, nil
	default:
		return false, fmt.Errorf("scl: invalid boolean value %q", s)
	}
}

// --- Conversion from XML to model ---

func convertSCL(raw *xmlSCL) (*SCL, error) {
	s := &SCL{
		Header: Header{
			ID:       raw.Header.ID,
			Version:  raw.Header.Version,
			Revision: raw.Header.Revision,
		},
	}

	for _, rawSub := range raw.Substations {
		s.Substations = append(s.Substations, convertSubstation(rawSub))
	}

	if raw.Communication != nil {
		s.Communication = convertCommunication(raw.Communication)
	}

	for _, rawIED := range raw.IEDs {
		ied, err := convertIED(rawIED)
		if err != nil {
			return nil, err
		}
		s.IEDs = append(s.IEDs, *ied)
	}

	dtt, err := convertDataTypeTemplates(raw.DataTypeTemplates)
	if err != nil {
		return nil, err
	}
	s.DataTypeTemplates = *dtt

	return s, nil
}

func convertIED(raw xmlIED) (*IED, error) {
	if raw.Name == "" {
		return nil, fmt.Errorf("scl: IED missing required name attribute")
	}
	ied := &IED{
		Name:         raw.Name,
		Desc:         raw.Desc,
		Manufacturer: raw.Manufacturer,
		Type:         raw.Type,
	}

	if raw.Services != nil {
		svc, err := convertServices(raw.Services)
		if err != nil {
			return nil, fmt.Errorf("scl: IED %q Services: %w", raw.Name, err)
		}
		ied.Services = svc
	}

	for _, rawAP := range raw.AccessPoints {
		ap := AccessPoint{Name: rawAP.Name}
		if rawAP.Server != nil {
			srv := &Server{}
			for _, rawLD := range rawAP.Server.LDevices {
				ld, err := convertLDevice(rawLD)
				if err != nil {
					return nil, fmt.Errorf("scl: IED %q LD %q: %w", raw.Name, rawLD.Inst, err)
				}
				srv.LDevices = append(srv.LDevices, *ld)
			}
			ap.Server = srv
		}
		ied.AccessPoints = append(ied.AccessPoints, ap)
	}

	return ied, nil
}

func convertLDevice(raw xmlLDevice) (*LDevice, error) {
	if raw.Inst == "" {
		return nil, fmt.Errorf("scl: LDevice missing required inst attribute")
	}
	ld := &LDevice{
		Inst: raw.Inst,
		Desc: raw.Desc,
	}

	if raw.LN0 != nil {
		ln, err := convertLN(*raw.LN0)
		if err != nil {
			return nil, fmt.Errorf("LN0: %w", err)
		}
		ld.LN0 = ln
	}

	for _, rawLN := range raw.LNs {
		ln, err := convertLN(rawLN)
		if err != nil {
			return nil, fmt.Errorf("LN %s%s%s: %w", rawLN.Prefix, rawLN.LNClass, rawLN.Inst, err)
		}
		ld.LNs = append(ld.LNs, *ln)
	}

	return ld, nil
}

func convertLN(raw xmlLN) (*LN, error) {
	if raw.LNClass == "" {
		return nil, fmt.Errorf("scl: LN missing required lnClass attribute")
	}
	if raw.LNType == "" {
		return nil, fmt.Errorf("scl: LN %s%s missing required lnType attribute", raw.Prefix, raw.LNClass)
	}
	ln := &LN{
		Prefix:  raw.Prefix,
		LNClass: raw.LNClass,
		Inst:    raw.Inst,
		LNType:  raw.LNType,
		Desc:    raw.Desc,
	}

	for _, rawDOI := range raw.DOIs {
		ln.DOIs = append(ln.DOIs, convertDOI(rawDOI))
	}
	for _, rawDS := range raw.DataSets {
		ln.DataSets = append(ln.DataSets, convertDataSet(rawDS))
	}
	for _, rawRC := range raw.Reports {
		rc, err := convertReportControl(rawRC)
		if err != nil {
			return nil, err
		}
		ln.Reports = append(ln.Reports, *rc)
	}
	for _, rawLog := range raw.Logs {
		ln.Logs = append(ln.Logs, Log(rawLog))
	}

	if raw.SettingControl != nil {
		ln.SettingControl = &SettingControl{
			NumOfSGs: raw.SettingControl.NumOfSGs,
			ActSG:    raw.SettingControl.ActSG,
			ResvTms:  raw.SettingControl.ResvTms,
		}
	}

	return ln, nil
}

func convertDOI(raw xmlDOI) DOI {
	doi := DOI{Name: raw.Name, Desc: raw.Desc}
	for _, d := range raw.DAIs {
		doi.DAIs = append(doi.DAIs, DAI(d))
	}
	for _, s := range raw.SDIs {
		doi.SDIs = append(doi.SDIs, convertSDI(s))
	}
	return doi
}

func convertSDI(raw xmlSDI) SDI {
	sdi := SDI{Name: raw.Name}
	for _, d := range raw.DAIs {
		sdi.DAIs = append(sdi.DAIs, DAI(d))
	}
	for _, s := range raw.SDIs {
		sdi.SDIs = append(sdi.SDIs, convertSDI(s))
	}
	return sdi
}

func convertDataSet(raw xmlDataSet) DataSet {
	ds := DataSet{Name: raw.Name, Desc: raw.Desc}
	for _, f := range raw.FCDAs {
		ds.FCDAs = append(ds.FCDAs, FCDA(f))
	}
	return ds
}

func convertReportControl(raw xmlReportControl) (*ReportControl, error) {
	rc := &ReportControl{
		Name:   raw.Name,
		Desc:   raw.Desc,
		RptID:  raw.RptID,
		DatSet: raw.DatSet,
	}

	if raw.ConfRev != "" {
		v, err := strconv.ParseUint(raw.ConfRev, 10, 32)
		if err != nil {
			return nil, fmt.Errorf("scl: ReportControl %q: invalid confRev %q: %w", raw.Name, raw.ConfRev, err)
		}
		rc.ConfRev = uint32(v)
	}

	buffered, err := parseBool(raw.Buffered)
	if err != nil {
		return nil, fmt.Errorf("scl: ReportControl %q: buffered: %w", raw.Name, err)
	}
	rc.Buffered = buffered

	if raw.BufTime != "" {
		v, err := strconv.ParseUint(raw.BufTime, 10, 32)
		if err != nil {
			return nil, fmt.Errorf("scl: ReportControl %q: invalid bufTime %q: %w", raw.Name, raw.BufTime, err)
		}
		rc.BufTime = uint32(v)
	}

	if raw.IntgPd != "" {
		v, err := strconv.ParseUint(raw.IntgPd, 10, 32)
		if err != nil {
			return nil, fmt.Errorf("scl: ReportControl %q: invalid intgPd %q: %w", raw.Name, raw.IntgPd, err)
		}
		rc.IntgPd = uint32(v)
	}

	if raw.TrgOps != nil {
		trgOps, tErr := convertTrgOps(raw.TrgOps, raw.Name)
		if tErr != nil {
			return nil, tErr
		}
		rc.TrgOps = trgOps
	}

	if raw.OptFields != nil {
		opt, oErr := convertOptFields(raw.OptFields, raw.Name)
		if oErr != nil {
			return nil, oErr
		}
		rc.OptFields = opt
	}

	return rc, nil
}

func convertTrgOps(raw *xmlTrgOps, rcName string) (TrgOps, error) {
	fields := []struct {
		name string
		val  string
		dst  *bool
	}{
		{"dchg", raw.Dchg, nil},
		{"qchg", raw.Qchg, nil},
		{"dupd", raw.Dupd, nil},
		{"period", raw.Period, nil},
		{"gi", raw.GI, nil},
	}
	var t TrgOps
	fields[0].dst = &t.Dchg
	fields[1].dst = &t.Qchg
	fields[2].dst = &t.Dupd
	fields[3].dst = &t.Period
	fields[4].dst = &t.GI
	for _, f := range fields {
		v, err := parseBool(f.val)
		if err != nil {
			return TrgOps{}, fmt.Errorf("scl: ReportControl %q TrgOps.%s: %w", rcName, f.name, err)
		}
		*f.dst = v
	}
	return t, nil
}

func convertOptFields(raw *xmlOptFields, rcName string) (OptFields, error) {
	fields := []struct {
		name string
		val  string
		dst  *bool
	}{
		{"seqNum", raw.SeqNum, nil},
		{"timeStamp", raw.TimeStamp, nil},
		{"dataSet", raw.DataSet, nil},
		{"reasonCode", raw.ReasonCode, nil},
		{"dataRef", raw.DataRef, nil},
		{"entryID", raw.EntryID, nil},
		{"configRef", raw.ConfigRef, nil},
		{"bufOvfl", raw.BufOvfl, nil},
	}
	var o OptFields
	fields[0].dst = &o.SeqNum
	fields[1].dst = &o.TimeStamp
	fields[2].dst = &o.DataSet
	fields[3].dst = &o.ReasonCode
	fields[4].dst = &o.DataRef
	fields[5].dst = &o.EntryID
	fields[6].dst = &o.ConfigRef
	fields[7].dst = &o.BufOvfl
	for _, f := range fields {
		v, err := parseBool(f.val)
		if err != nil {
			return OptFields{}, fmt.Errorf("scl: ReportControl %q OptFields.%s: %w", rcName, f.name, err)
		}
		*f.dst = v
	}
	return o, nil
}

func convertDataTypeTemplates(raw xmlDataTypeTemplates) (*DataTypeTemplates, error) {
	dtt := &DataTypeTemplates{}

	for _, rawLNT := range raw.LNodeTypes {
		lnt := LNodeType{
			ID:      rawLNT.ID,
			LNClass: rawLNT.LNClass,
			Desc:    rawLNT.Desc,
		}
		for _, d := range rawLNT.DOs {
			if d.Name == "" {
				return nil, fmt.Errorf("scl: LNodeType %q: DO missing required name attribute", rawLNT.ID)
			}
			if d.Type == "" {
				return nil, fmt.Errorf("scl: LNodeType %q DO %q: missing required type attribute", rawLNT.ID, d.Name)
			}
			lnt.DOs = append(lnt.DOs, DO(d))
		}
		dtt.LNodeTypes = append(dtt.LNodeTypes, lnt)
	}

	for _, rawDOT := range raw.DOTypes {
		dot := DOType{
			ID:   rawDOT.ID,
			CDC:  rawDOT.CDC,
			Desc: rawDOT.Desc,
		}
		for _, d := range rawDOT.DAs {
			da := DA{
				Name:  d.Name,
				FC:    d.FC,
				BType: d.BType,
				Type:  d.Type,
				Desc:  d.Desc,
				Val:   d.Val,
			}
			if d.Count != "" {
				v, err := strconv.Atoi(d.Count)
				if err != nil {
					return nil, fmt.Errorf("scl: DOType %q DA %q: invalid count %q: %w", rawDOT.ID, d.Name, d.Count, err)
				}
				da.Count = v
			}
			dot.DAs = append(dot.DAs, da)
		}
		for _, s := range rawDOT.SDOs {
			dot.SDOs = append(dot.SDOs, SDO(s))
		}
		dtt.DOTypes = append(dtt.DOTypes, dot)
	}

	for _, rawDAT := range raw.DATypes {
		dat := DAType{
			ID:   rawDAT.ID,
			Desc: rawDAT.Desc,
		}
		for _, b := range rawDAT.BDAs {
			bda := BDA{
				Name:  b.Name,
				BType: b.BType,
				Type:  b.Type,
				Desc:  b.Desc,
				Val:   b.Val,
			}
			if b.Count != "" {
				v, err := strconv.Atoi(b.Count)
				if err != nil {
					return nil, fmt.Errorf("scl: DAType %q BDA %q: invalid count %q: %w", rawDAT.ID, b.Name, b.Count, err)
				}
				bda.Count = v
			}
			dat.BDAs = append(dat.BDAs, bda)
		}
		dtt.DATypes = append(dtt.DATypes, dat)
	}

	for _, rawEnum := range raw.EnumTypes {
		et := EnumType{
			ID:   rawEnum.ID,
			Desc: rawEnum.Desc,
		}
		for _, v := range rawEnum.Vals {
			ord := 0
			if v.Ord != "" {
				parsed, err := strconv.Atoi(v.Ord)
				if err != nil {
					return nil, fmt.Errorf("scl: EnumType %q: invalid ord %q: %w", rawEnum.ID, v.Ord, err)
				}
				ord = parsed
			}
			et.Vals = append(et.Vals, EnumVal{Ord: ord, Value: v.Desc})
		}
		dtt.EnumTypes = append(dtt.EnumTypes, et)
	}

	return dtt, nil
}

// --- Substation conversion ---

func convertSubstation(raw xmlSubstation) Substation {
	sub := Substation{Name: raw.Name, Desc: raw.Desc}
	for _, rawVL := range raw.VoltageLevels {
		vl := VoltageLevel{Name: rawVL.Name, Desc: rawVL.Desc}
		if rawVL.Voltage != nil {
			vl.Voltage = strings.TrimSpace(rawVL.Voltage.Value)
		}
		for _, rawBay := range rawVL.Bays {
			bay := Bay{Name: rawBay.Name, Desc: rawBay.Desc}
			for _, rawCE := range rawBay.ConductingEquipments {
				bay.ConductingEquipments = append(bay.ConductingEquipments, ConductingEquipment(rawCE))
			}
			vl.Bays = append(vl.Bays, bay)
		}
		sub.VoltageLevels = append(sub.VoltageLevels, vl)
	}
	return sub
}

// --- Communication conversion ---

func convertCommunication(raw *xmlCommunication) *Communication {
	comm := &Communication{}
	for _, rawSN := range raw.SubNetworks {
		sn := SubNetwork{Name: rawSN.Name, Desc: rawSN.Desc, Type: rawSN.Type}
		for _, rawAP := range rawSN.ConnectedAPs {
			cap := ConnectedAP{IEDName: rawAP.IEDName, APName: rawAP.APName}
			if rawAP.Address != nil {
				cap.Address = convertPs(rawAP.Address.Ps)
			}
			for _, rawGSE := range rawAP.GSEs {
				gse := GSEAddress{LDInst: rawGSE.LDInst, CBName: rawGSE.CBName}
				if rawGSE.Address != nil {
					gse.Address = convertPs(rawGSE.Address.Ps)
				}
				if rawGSE.MinTime != nil {
					gse.MinTime = strings.TrimSpace(rawGSE.MinTime.Value)
				}
				if rawGSE.MaxTime != nil {
					gse.MaxTime = strings.TrimSpace(rawGSE.MaxTime.Value)
				}
				cap.GSEs = append(cap.GSEs, gse)
			}
			for _, rawSMV := range rawAP.SMVs {
				smv := SMVAddress{LDInst: rawSMV.LDInst, CBName: rawSMV.CBName}
				if rawSMV.Address != nil {
					smv.Address = convertPs(rawSMV.Address.Ps)
				}
				cap.SMVs = append(cap.SMVs, smv)
			}
			sn.ConnectedAPs = append(sn.ConnectedAPs, cap)
		}
		comm.SubNetworks = append(comm.SubNetworks, sn)
	}
	return comm
}

func convertPs(raw []xmlP) []P {
	ps := make([]P, len(raw))
	for i, p := range raw {
		ps[i] = P{Type: p.Type, Value: strings.TrimSpace(p.Value)}
	}
	return ps
}

// --- Services conversion ---

func convertServices(raw *xmlServices) (*Services, error) {
	svc := &Services{
		DynAssociation:          raw.DynAssociation != nil,
		GetDirectory:            raw.GetDirectory != nil,
		GetDataObjectDefinition: raw.GetDataObjectDefinition != nil,
		GetDataSetValue:         raw.GetDataSetValue != nil,
		DataSetDirectory:        raw.DataSetDirectory != nil,
		ReadWrite:               raw.ReadWrite != nil,
		GetCBValues:             raw.GetCBValues != nil,
		FileHandling:            raw.FileHandling != nil,
	}

	if raw.ConfDataSet != nil {
		cds := &ConfDataSet{}
		if raw.ConfDataSet.Max != "" {
			v, err := strconv.Atoi(raw.ConfDataSet.Max)
			if err != nil {
				return nil, fmt.Errorf("ConfDataSet max: %w", err)
			}
			cds.Max = v
		}
		if raw.ConfDataSet.MaxAttributes != "" {
			v, err := strconv.Atoi(raw.ConfDataSet.MaxAttributes)
			if err != nil {
				return nil, fmt.Errorf("ConfDataSet maxAttributes: %w", err)
			}
			cds.MaxAttributes = v
		}
		if raw.ConfDataSet.Modify != "" {
			b, err := parseBool(raw.ConfDataSet.Modify)
			if err != nil {
				return nil, fmt.Errorf("ConfDataSet modify: %w", err)
			}
			cds.Modify = b
		}
		svc.ConfDataSet = cds
	}

	if raw.ConfReportCtrl != nil {
		crc := &ConfReportControl{BufMode: raw.ConfReportCtrl.BufMode}
		if raw.ConfReportCtrl.Max != "" {
			v, err := strconv.Atoi(raw.ConfReportCtrl.Max)
			if err != nil {
				return nil, fmt.Errorf("ConfReportControl max: %w", err)
			}
			crc.Max = v
		}
		svc.ConfReportCtrl = crc
	}

	if raw.ReportSettings != nil {
		svc.ReportSettings = &ReportSettings{
			CBName:    raw.ReportSettings.CBName,
			DatSet:    raw.ReportSettings.DatSet,
			RptID:     raw.ReportSettings.RptID,
			OptFields: raw.ReportSettings.OptFields,
			BufTime:   raw.ReportSettings.BufTime,
			TrgOps:    raw.ReportSettings.TrgOps,
			IntgPd:    raw.ReportSettings.IntgPd,
		}
	}

	if raw.ConfLNs != nil {
		clns := &ConfLNs{}
		if raw.ConfLNs.FixPrefix != "" {
			b, err := parseBool(raw.ConfLNs.FixPrefix)
			if err != nil {
				return nil, fmt.Errorf("ConfLNs fixPrefix: %w", err)
			}
			clns.FixPrefix = b
		}
		if raw.ConfLNs.FixLnInst != "" {
			b, err := parseBool(raw.ConfLNs.FixLnInst)
			if err != nil {
				return nil, fmt.Errorf("ConfLNs fixLnInst: %w", err)
			}
			clns.FixLnInst = b
		}
		svc.ConfLNs = clns
	}

	if raw.GOOSE != nil {
		gs := &GOOSEService{}
		if raw.GOOSE.Max != "" {
			v, err := strconv.Atoi(raw.GOOSE.Max)
			if err != nil {
				return nil, fmt.Errorf("GOOSE max: %w", err)
			}
			gs.Max = v
		}
		if raw.GOOSE.FixedOffs != "" {
			b, err := parseBool(raw.GOOSE.FixedOffs)
			if err != nil {
				return nil, fmt.Errorf("GOOSE fixedOffs: %w", err)
			}
			gs.FixedOffs = b
		}
		svc.GOOSE = gs
	}

	if raw.SMVsc != nil {
		ss := &SMVService{}
		if raw.SMVsc.Max != "" {
			v, err := strconv.Atoi(raw.SMVsc.Max)
			if err != nil {
				return nil, fmt.Errorf("SMVsc max: %w", err)
			}
			ss.Max = v
		}
		svc.SMVsc = ss
	}

	return svc, nil
}

