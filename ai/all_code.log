// Command scl-parse demonstrates parsing an SCL file and printing
// a summary of its contents.
package main

import (
	"fmt"
	"log"
	"os"

	"github.com/otfabric/go-iec61850/scl"
)

func main() {
	if len(os.Args) < 2 {
		fmt.Fprintf(os.Stderr, "usage: scl-parse <file.scd>\n")
		os.Exit(1)
	}
	path := os.Args[1]

	s, err := scl.ParseFile(path)
	if err != nil {
		log.Fatalf("parse: %v", err)
	}

	fmt.Printf("SCL Header: ID=%s Version=%s Revision=%s\n\n",
		s.Header.ID, s.Header.Version, s.Header.Revision)

	fmt.Printf("IEDs (%d):\n", len(s.IEDs))
	for _, ied := range s.IEDs {
		fmt.Printf("  %s", ied.Name)
		if ied.Manufacturer != "" {
			fmt.Printf(" (manufacturer=%s)", ied.Manufacturer)
		}
		fmt.Println()

		for _, ap := range ied.AccessPoints {
			if ap.Server == nil {
				continue
			}
			for _, ld := range ap.Server.LDevices {
				fmt.Printf("    LD: %s\n", ld.Inst)
			}
		}
	}

	fmt.Printf("\nData type templates:\n")
	fmt.Printf("  LNodeTypes: %d\n", len(s.DataTypeTemplates.LNodeTypes))
	fmt.Printf("  DOTypes:    %d\n", len(s.DataTypeTemplates.DOTypes))
	fmt.Printf("  DATypes:    %d\n", len(s.DataTypeTemplates.DATypes))
	fmt.Printf("  EnumTypes:  %d\n", len(s.DataTypeTemplates.EnumTypes))

	fmt.Printf("\nValidation:\n")
	findings := scl.Validate(s)
	if len(findings) == 0 {
		fmt.Println("  No issues found.")
	} else {
		for _, f := range findings {
			fmt.Printf("  [%s] %s: %s\n", f.Severity, f.Path, f.Message)
		}
	}

	fmt.Printf("\nFlat rows: %d\n", len(scl.Flatten(s)))
	fmt.Printf("Datasets:  %d\n", len(scl.ExportDataSets(s)))
	fmt.Printf("Reports:   %d\n", len(scl.ExportReports(s)))

	fmt.Println("\nModel tree:")
	if err := scl.PrintTree(os.Stdout, s); err != nil {
		log.Fatalf("print tree: %v", err)
	}
}

